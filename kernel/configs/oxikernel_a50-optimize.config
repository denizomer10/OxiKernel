# OxiKernel configuration - Galaxy A50 (Exynos 9610) dead-driver elimination
#
# Micro-optimization pass: strips built-in drivers for hardware that the
# Galaxy A50 simply does not have. Fewer built-in drivers means a smaller
# Image, faster boot, less i-cache pressure and a smaller attack surface.
#
# Everything the A50 actually needs is intentionally PRESERVED:
#   - UFS storage (SCSI_UFS_EXYNOS), display, camera (FIMC-IS2), modem,
#     audio, sensors, power/charger, Mali GPU, SCSC WiFi, FM radio.
#   - USB core + DWC3 + gadget + USB_STORAGE (OTG), generic CDC ethernet.
#   - ext4 / f2fs / erofs / vfat / sdfat / overlay / incrementalfs.
#   - HID core + HID_GENERIC + HID_MULTITOUCH + HID_SAMSUNG (touchscreen).
#
# This file is merged last (see build.sh) so its "# ... is not set" entries
# win over the base defconfig. Symbols that Kconfig forces via `select` are
# disabled at their selector (e.g. MEDIA_SUBDRV_AUTOSELECT) so the removal
# actually sticks.

# ---------------------------------------------------------------------------
# 1. Analog/digital TV tuner silicon  (A50 has no TV tuner)
#
# MEDIA_SUBDRV_AUTOSELECT is the selector that auto-enables ~13 tuner/decoder
# chips via `select`. Disable it first so those selects stop firing. With it
# off, Kconfig exposes the "Customize TV tuners" menu whose chips default to
# =m, so every chip is switched off explicitly below.
#
# NOTE on CONFIG_MEDIA_TUNER: it is a prompt-less tristate with `default y`
# gated on MEDIA_RADIO_SUPPORT. Since the A50's S5E9610 FM radio lives behind
# MEDIA_RADIO_SUPPORT, the tiny central tuner-core shim cannot be turned off
# without also killing FM radio. It is intentionally left alone (~3 KB); all
# the real per-chip silicon drivers are removed below.
# ---------------------------------------------------------------------------
# CONFIG_MEDIA_SUBDRV_AUTOSELECT is not set
# CONFIG_MEDIA_TUNER_SIMPLE is not set
# CONFIG_MEDIA_TUNER_TDA8290 is not set
# CONFIG_MEDIA_TUNER_TDA827X is not set
# CONFIG_MEDIA_TUNER_TDA18271 is not set
# CONFIG_MEDIA_TUNER_TDA9887 is not set
# CONFIG_MEDIA_TUNER_TEA5761 is not set
# CONFIG_MEDIA_TUNER_TEA5767 is not set
# CONFIG_MEDIA_TUNER_MSI001 is not set
# CONFIG_MEDIA_TUNER_MT20XX is not set
# CONFIG_MEDIA_TUNER_MT2060 is not set
# CONFIG_MEDIA_TUNER_MT2063 is not set
# CONFIG_MEDIA_TUNER_MT2266 is not set
# CONFIG_MEDIA_TUNER_MT2131 is not set
# CONFIG_MEDIA_TUNER_QT1010 is not set
# CONFIG_MEDIA_TUNER_XC2028 is not set
# CONFIG_MEDIA_TUNER_XC5000 is not set
# CONFIG_MEDIA_TUNER_XC4000 is not set
# CONFIG_MEDIA_TUNER_MXL5005S is not set
# CONFIG_MEDIA_TUNER_MXL5007T is not set
# CONFIG_MEDIA_TUNER_MC44S803 is not set
# CONFIG_MEDIA_TUNER_MAX2165 is not set
# CONFIG_MEDIA_TUNER_TDA18218 is not set
# CONFIG_MEDIA_TUNER_FC0011 is not set
# CONFIG_MEDIA_TUNER_FC0012 is not set
# CONFIG_MEDIA_TUNER_FC0013 is not set
# CONFIG_MEDIA_TUNER_TDA18212 is not set
# CONFIG_MEDIA_TUNER_E4000 is not set
# CONFIG_MEDIA_TUNER_FC2580 is not set
# CONFIG_MEDIA_TUNER_M88RS6000T is not set
# CONFIG_MEDIA_TUNER_TUA9001 is not set
# CONFIG_MEDIA_TUNER_SI2157 is not set
# CONFIG_MEDIA_TUNER_IT913X is not set
# CONFIG_MEDIA_TUNER_R820T is not set
# CONFIG_MEDIA_TUNER_MXL301RF is not set
# CONFIG_MEDIA_TUNER_QM1D1C0042 is not set

# ---------------------------------------------------------------------------
# 2. Infrared remote control  (A50 has no IR receiver / blaster)
# ---------------------------------------------------------------------------
# CONFIG_RC_CORE is not set
# CONFIG_RC_MAP is not set
# CONFIG_RC_DECODERS is not set
# CONFIG_IR_NEC_DECODER is not set
# CONFIG_IR_RC5_DECODER is not set
# CONFIG_IR_RC6_DECODER is not set
# CONFIG_IR_JVC_DECODER is not set
# CONFIG_IR_SONY_DECODER is not set
# CONFIG_IR_SANYO_DECODER is not set
# CONFIG_IR_SHARP_DECODER is not set
# CONFIG_IR_MCE_KBD_DECODER is not set
# CONFIG_IR_XMP_DECODER is not set

# ---------------------------------------------------------------------------
# 3. External USB peripherals  (chip-specific OTG dongles + USB-serial)
#
# Removed: Realtek / ASIX / SMSC / Pegasus USB-Ethernet dongles and
# FTDI / PL2303 USB-serial converters -- none are A50 hardware.
# Kept:    USB core, DWC3 controller, USB gadget (charging/ADB/MTP), and
#          USB_STORAGE so OTG USB flash drives still work.
# ---------------------------------------------------------------------------
# CONFIG_USB_RTL8150 is not set
# CONFIG_USB_RTL8152 is not set
# CONFIG_USB_NET_AX8817X is not set
# CONFIG_USB_NET_AX88179_178A is not set
# CONFIG_USB_NET_SMSC75XX is not set
# CONFIG_USB_NET_SMSC95XX is not set
# CONFIG_USB_NET_NET1080 is not set
# CONFIG_USB_NET_CDC_SUBSET is not set
# CONFIG_USB_NET_CDC_SUBSET_ENABLE is not set
# CONFIG_USB_BELKIN is not set
# CONFIG_USB_ARMLINUX is not set
# CONFIG_USB_NET_ZAURUS is not set
# CONFIG_USB_SERIAL is not set
# CONFIG_USB_SERIAL_FTDI_SIO is not set
# CONFIG_USB_SERIAL_PL2303 is not set

# ---------------------------------------------------------------------------
# 4. Unused filesystems
#
# CRAMFS   : embedded compressed ROM FS, unused on Android.
# ECRYPT_FS: Linux eCryptfs stacking FS; Android uses FBE (ext4/f2fs
#            encryption) instead, so eCryptfs is dead weight.
# ---------------------------------------------------------------------------
# CONFIG_CRAMFS is not set
# CONFIG_ECRYPT_FS is not set

# ---------------------------------------------------------------------------
# 6. SILICON-LEVEL: runtime instrumentation on hot paths  (Exynos 9610)
#
# These are always-on tracepoints / debug monitors that sit on the GPU, bus
# and scheduler hot paths and burn cycles + power on every event. Removing
# them is a genuine silicon-level win (fewer branches, no ring-buffer writes
# in interrupt/scheduling paths). Crash-dump infrastructure is PRESERVED.
#
# Mali GPU (G72 MP3): Streamline/GATOR tracing + debug sysfs + fault dumps.
# The GPU driver keeps DVFS/PM/thermal/QoS/BTS (performance-relevant) --
# only the profiling/logging layers go.
# ---------------------------------------------------------------------------
# CONFIG_MALI_GATOR_SUPPORT is not set
# CONFIG_MALI_MIDGARD_ENABLE_TRACE is not set
# CONFIG_MALI_EXYNOS_DEBUG is not set
# CONFIG_MALI_EXYNOS_DEBUG_FAULT_DUMP is not set
# CONFIG_MALI_DEBUG_SYS is not set
# CONFIG_MALI_DEBUG_KERNEL_SYSFS is not set

# ---------------------------------------------------------------------------
# Bus Congestion Monitor (BCM_DBG): continuously samples interconnect traffic
# for debug. Pure monitoring overhead on the memory bus -> removed.
# ---------------------------------------------------------------------------
# CONFIG_EXYNOS_BCM_DBG is not set
# CONFIG_EXYNOS_BCM_DBG_GNR is not set

# ---------------------------------------------------------------------------
# SEC_DEBUG runtime logging: per-event history/init/comment/task logs add
# bookkeeping to syscalls and context switches. The crash-dump core
# (SEC_DEBUG, RESET_REASON, DUMP_SUMMARY, LAST/FIRST_KMSG, HW_PARAM) is kept
# so post-mortem debugging still works; only the always-on loggers go.
# ---------------------------------------------------------------------------
# CONFIG_SEC_DEBUG_HIST_LOG is not set
# CONFIG_SEC_DEBUG_LIMIT_BACKTRACE is not set

# ---------------------------------------------------------------------------
# Rarely-used tracing hooks (uprobes, GPIO trace events, per-freq time stats).
# FTRACE core + TRACEPOINTS stay (Android systrace/atrace depend on them),
# but these specific event sources are dropped.
# ---------------------------------------------------------------------------
# CONFIG_UPROBE_EVENTS is not set
# CONFIG_TRACING_EVENTS_GPIO is not set
# CONFIG_CPU_FREQ_TIMES is not set

# ---------------------------------------------------------------------------
# 5. Game-controller HID quirks + force-feedback rumble
#
# Only dedicated gamepad / joystick rumble engines and console controller
# drivers are removed. The A50's own vibration motor is driven by the
# haptic / timed-output path, NOT by HID force-feedback, so this is safe.
# The touchscreen path (HID_MULTITOUCH / HID_SAMSUNG / HID_GENERIC) is
# untouched.
# ---------------------------------------------------------------------------
# CONFIG_HID_ACRUX is not set
# CONFIG_HID_ACRUX_FF is not set
# CONFIG_HID_DRAGONRISE is not set
# CONFIG_DRAGONRISE_FF is not set
# CONFIG_HID_EMS_FF is not set
# CONFIG_HID_PANTHERLORD is not set
# CONFIG_PANTHERLORD_FF is not set
# CONFIG_HID_PLAYSTATION is not set
# CONFIG_PLAYSTATION_FF is not set
# CONFIG_HID_GREENASIA is not set
# CONFIG_GREENASIA_FF is not set
# CONFIG_HID_SMARTJOYPLUS is not set
# CONFIG_SMARTJOYPLUS_FF is not set
# CONFIG_HID_NINTENDO is not set
# CONFIG_HID_TIVO is not set
# CONFIG_LOGITECH_FF is not set
# CONFIG_LOGIRUMBLEPAD2_FF is not set
# CONFIG_LOGIG940_FF is not set
# CONFIG_LOGIWHEELS_FF is not set

# ---------------------------------------------------------------------------
# 6. A50-only HID prune: every other USB HID vendor quirk
#
# The A50's touchscreen is I2C (Melfas MSS100), NOT USB HID. USB HID on a
# phone only matters for OTG accessories. Kept: HID core + HIDRAW +
# HID_GENERIC + HID_MULTITOUCH + HID_SAMSUNG (covers OTG touchpads/mice).
# Everything vendor-specific below is multi-device baggage from desktop
# kernels and is dropped. None of these are selected by A50 code (verified:
# no `select HID_*` for these in A50 drivers).
# ---------------------------------------------------------------------------
# CONFIG_HID_A4TECH is not set
# CONFIG_HID_APPLE is not set
# CONFIG_HID_BELKIN is not set
# CONFIG_HID_CHERRY is not set
# CONFIG_HID_CHICONY is not set
# CONFIG_HID_PRODIKEYS is not set
# CONFIG_HID_CYPRESS is not set
# CONFIG_HID_ELECOM is not set
# CONFIG_HID_EZKEY is not set
# CONFIG_HID_HOLTEK is not set
# CONFIG_HID_KEYTOUCH is not set
# CONFIG_HID_KYE is not set
# CONFIG_HID_UCLOGIC is not set
# CONFIG_HID_WALTOP is not set
# CONFIG_HID_GYRATION is not set
# CONFIG_HID_TWINHAN is not set
# CONFIG_HID_KENSINGTON is not set
# CONFIG_HID_LCPOWER is not set
# CONFIG_HID_LOGITECH is not set
# CONFIG_HID_LOGITECH_DJ is not set
# CONFIG_HID_LOGITECH_HIDPP is not set
# CONFIG_HID_MAGICMOUSE is not set
# CONFIG_HID_MICROSOFT is not set
# CONFIG_HID_MONTEREY is not set
# CONFIG_HID_NTRIG is not set
# CONFIG_HID_ORTEK is not set
# CONFIG_HID_PETALYNX is not set
# CONFIG_HID_PICOLCD is not set
# CONFIG_HID_PRIMAX is not set
# CONFIG_HID_ROCCAT is not set
# CONFIG_HID_SAITEK is not set
# CONFIG_HID_SONY is not set
# CONFIG_HID_SPEEDLINK is not set
# CONFIG_HID_SUNPLUS is not set
# CONFIG_HID_TOPSEED is not set
# CONFIG_HID_THRUSTMASTER is not set
# CONFIG_HID_WACOM is not set
# CONFIG_HID_WIIMOTE is not set
# CONFIG_HID_ZEROPLUS is not set
# CONFIG_HID_ZYDACRON is not set
# CONFIG_HID_OVR is not set
# CONFIG_HID_TVR is not set

# ---------------------------------------------------------------------------
# 7. Joystick + graphics-tablet USB drivers (A50 has neither)
#
# INPUT_JOYSTICK / INPUT_TABLET are menu gates; XPAD is the Xbox pad driver
# (FF+LEDS are its rumble/LED children); TABLET_USB_* are Wacom-style USB
# drawing tablets. A phone never carries these. The A50 vibration motor is
# on the haptic/timed-output path (SEC_VIB), untouched.
# ---------------------------------------------------------------------------
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_JOYSTICK_XPAD is not set
# CONFIG_JOYSTICK_XPAD_FF is not set
# CONFIG_JOYSTICK_XPAD_LEDS is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_TABLET_USB_ACECAD is not set
# CONFIG_TABLET_USB_AIPTEK is not set
# CONFIG_TABLET_USB_GTCO is not set
# CONFIG_TABLET_USB_HANWANG is not set
# CONFIG_TABLET_USB_KBTAB is not set

# ---------------------------------------------------------------------------
# 8. Ethernet + WiFi vendor menu gates (multi-device baggage)
#
# A50 networking = Shannon SS310AP modem (SIPC) + SLSI SCSC WiFi/BT combo
# (drivers/net/wireless/scsc, independent of the WLAN_VENDOR gates below).
# There is NO wired ethernet silicon on the phone; USB ethernet dongles were
# already dropped in section 3. NET_VENDOR_* / WLAN_VENDOR_* are pure menu
# gates with no code of their own -- disabling them just hides desktop /
# laptop NIC drivers from the build. SXGBE (Samsung 10G ethernet) is already
# off in the base defconfig. Generic USB CDC (tethering) is KEPT.
# ---------------------------------------------------------------------------
# CONFIG_NET_VENDOR_ALACRITECH is not set
# CONFIG_NET_VENDOR_AMAZON is not set
# CONFIG_NET_VENDOR_AMD is not set
# CONFIG_NET_VENDOR_AQUANTIA is not set
# CONFIG_NET_VENDOR_ARC is not set
# CONFIG_NET_VENDOR_BROADCOM is not set
# CONFIG_NET_VENDOR_EZCHIP is not set
# CONFIG_NET_VENDOR_HISILICON is not set
# CONFIG_NET_VENDOR_HUAWEI is not set
# CONFIG_NET_VENDOR_INTEL is not set
# CONFIG_NET_VENDOR_I825XX is not set
# CONFIG_NET_VENDOR_MARVELL is not set
# CONFIG_NET_VENDOR_MELLANOX is not set
