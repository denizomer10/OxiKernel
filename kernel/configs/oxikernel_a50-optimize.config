# ---------------------------------------------------------------------------
# 9. Audio / power leaves with no A50 DTS node
#
# CS35L41 (Cirrus amp, MFD+SPI+SND): no cs35l41 node in universal9610 DTS;
# A50 audio is ABOX + Realtek RT5665 + NXP TFA98xx (kept). S2MPB03 regulator:
# A50 PMIC is S2MPU09 (+SM5713); no s2mpb03 node. RL6231 (Realtek helper)
# follows RT5665 via select, so it is left alone.
# ---------------------------------------------------------------------------
# CONFIG_MFD_CS35L41 is not set
# CONFIG_MFD_CS35L41_SPI is not set
# CONFIG_SND_SOC_CS35L41 is not set
# CONFIG_REGULATOR_S2MPB03 is not set
