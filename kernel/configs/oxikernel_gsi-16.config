# OxiKernel configuration - Android 16 (API 36) GSI support
#
# Enables the kernel options required by the official Google Generic System
# Image (GSI) for Android 16 (API level 36) and phhGSI-style AOSP builds so a
# clean vendor can boot a stock Android system.img on Exynos9610 (A50).
#
# This configuration targets Android 16 (API 36). It is derived from the
# gsi-12 configuration and adds the few extra symbols Android 16 GSI expects
# that are not already covered there. The fs-verity and binderfs backports
# from the Motorola exynos9610-lineage-23.2 (4.14.357-openela) tree are still
# required and are inherited from the shared GSI options below.

# --- Shared GSI base (identical to gsi-12) ---------------------------------

# Overlay filesystem: GSI mounts /system as an overlay over /.
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y

# /dev/mem: some GSI / vendor HAL helpers expect it.
CONFIG_DEVMEM=y

# Android binder: GSI expects the standard binder,hwbinder,vndbinder set.
# binderfs (backported) lets the framework mount /dev/binderfs; the legacy
# char devices are still created for compatibility.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# fs-verity: backported from 4.14.357-openela (Motorola exynos9610-lineage-23.2).
# Android 16 GSI requires fs-verity on certain system/vendor files.
# Builtin signatures let the GSI verify against its own .fs-verity keyring.
CONFIG_FS_VERITY=y
CONFIG_FS_VERITY_BUILTIN_SIGNATURES=y
CONFIG_UNICODE=y

# Android verity target: GSI's vbmeta/verity + AVB metadata.
CONFIG_DM_VERITY=y
CONFIG_DM_ANDROID_VERITY=y
CONFIG_DM_VERITY_AVB=y

# squashfs: a few GSI variants ship as squashfs.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y

# tmpfs + devtmpfs: mandatory for the GSI early-userspace mount of /.
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# SELinux: GSI ships its own policy; keep the kernel LSM hooks enabled
# so the GSI enforcing policy can load. Permissive is applied by the
# selinux-permissive variant subconfig if requested.
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y

# ION: vendor HALs (camera, media, gralloc) under GSI rely on it.
CONFIG_ION=y

# Low memory killer: GSI / Android framework expects the in-kernel
# lowmemorykiller to reap background processes.
CONFIG_ANDROID_LOW_MEMORY_KILLER=y

# Seccomp syscall filtering used by the GSI zygote / mediaserver.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# userfaultfd: probed by ART (heap compaction / GC) and by installd on
# Android 13+; A16 GSI userspace detects its absence and degrades, but the
# syscall is expected on modern kernels. Harmless if unused.
CONFIG_USERFAULTFD=y

# TCP_DIAG / INET_DIAG are already =y; keep FQ for GSI networking.
CONFIG_NET_SCH_FQ=y

# VoWiFi / IMS: ePDG uses IPsec/XFRM interfaces and policy migration when
# handing calls between cellular and Wi-Fi. Android netd and carrier rules
# also require policy routing, packet marks, cgroups and DSCP matching.
CONFIG_XFRM_INTERFACE=y
CONFIG_XFRM_MIGRATE=y
CONFIG_NET_KEY_MIGRATE=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NETFILTER_XT_MATCH_ESP=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_CGROUP=y
CONFIG_NETFILTER_XT_MATCH_DSCP=y
CONFIG_NETFILTER_XT_TARGET_DSCP=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_TUN=y
CONFIG_PPP=y

# --- Android 16 (API 36) specific additions --------------------------------

# EROFS: the Android 16 GSI system image is shipped as EROFS by default
# (and many vendor images on newer devices use it as well). Without it the
# first-stage init cannot mount /system and the device reboots.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_ZIP=y

# Loop devices: GSI / adb remount and some overlay setups loop-mount images.
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8

# Android paranoid network: Android 16 GSI frameworks expect the per-uid
# network permission hooks to be present.
CONFIG_ANDROID_PARANOID_NETWORK=y

# Namespaces used by the GSI microdroid / virtualization and app sandboxing.
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# f2fs: GSI userdata late-mount still expects f2fs support on A16.
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y

# CONFIG_SDCARD_FS: A16 GSI relies on the fuse-based media store, but
# sdcardfs stays ENABLED for parity with the known-good (15.08.2026) booting
# baseline: fs/sdcardfs/packagelist.c owns uid_to_packagename(), which
# drivers/misc/uid_sys_stats.c calls, and the base defconfigs already set
# CONFIG_SDCARD_FS=y. Do not unset it.

# --- Power management / shutdown + recovery ----------------------------------
# CONFIG_SEC_REBOOT MUST be enabled. When it is set, drivers/samsung/sec_reboot.c
# registers pm_power_off = sec_power_off() (drives PS_HOLD low so the PMIC truly
# powers off) and arm_pm_restart = sec_reboot() (writes the reboot reason, e.g.
# SEC_RESET_REASON_RECOVERY, into SEC_DEBUG_PANIC_INFORM so the bootloader can
# enter recovery/download). With it disabled, sec_reboot.c is not compiled, the
# recovery reason is never written (reboot recovery does nothing) and power-off
# falls back to the bare exynos path. Enabling it fixes "shutdown reboots" and
# "reboot recovery does not enter recovery".
CONFIG_SEC_REBOOT=y

# --- Watchdogs disabled to match the known-good (15.08.2026) booting baseline.
# With SEC_DEBUG_SOFTDOG_PWDT a slow early boot turns a watchdog bite into a
# panic/reboot loop. The base defconfigs enable both; later fragment lines win
# (the merge emits "override: reassigning to symbol" warnings for these).
# The boot.img cmdline additionally carries
# "nowatchdog hardlockup_panic=0 nmi_watchdog=0" as belt and braces.
# CONFIG_S3C2410_WATCHDOG is not set
# CONFIG_SEC_DEBUG_SOFTDOG_PWDT is not set

# --- IPC / SysV (Android 16 GSI expects SYSVIPC + IPC_NS for some vendor
# HALs and the framework's IPC; IPC_NS is already requested above but it
# depends on SYSVIPC, which was disabled and silently dropped it).
CONFIG_SYSVIPC=y

# --- Encryption keyring support (File-Based Encryption / metadata encryption
# on ext4/f2fs userdata). Required for Android 16 FBE key handling.
CONFIG_ENCRYPTED_KEYS=y

# --- Android metadata encryption (dm-bow wraps the userdata block device so
# the framework can set up dm-default-key / FBE on top). Source is present in
# this tree; just enable it to match the A16 GSI expectation.
CONFIG_DM_BOW=y

# --- Inline crypto / metadata encryption stack (Android 16 requirement).
# These symbols default to 'n' because the source is backported from the
# Motorola exynos9610-lineage-23.2 (4.14.357-openela) tree. They provide
# dm-default-key + blk-crypto so userdata metadata encryption works.
# CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y enables SOFTWARE fallback for inline
# encryption, allowing FBE to work WITHOUT hardware ICE/TEE (software FBE).
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_DM_DEFAULT_KEY=y

# --- dm-default-key software metadata encryption. In 4.14 the ESSIV helper is
# provided internally by dm-crypt (no standalone CRYPTO_ESSIV symbol), and ECC
# is pulled in by CRYPTO_ECDH below, so neither needs an explicit line here.
# DM_CRYPT and DM_DEFAULT_KEY are already enabled (core_defconfig / above).

# --- Kernel keyring + userspace crypto API. Android 12+ FBE/metadata and the
# KeyMint/keymaster + keystore2 + vold stack use AF_ALG via the crypto user API
# to derive/store keys. These are needed even with a software (non-TEE) HAL.
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_RNG=y
CONFIG_CRYPTO_CRYPTD=y

# --- KeyMint / Gatekeeper (software) key-agreement and EC support.
CONFIG_CRYPTO_DH=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_ECDH=y

# --- Debug snapshot spinlock (required for spinlock_api_smp.h)
CONFIG_DEBUG_SNAPSHOT_SPINLOCK=y

# --- f2fs compression: source is NOT present in this 4.14.336 tree (it was
# backported later in android-common). Left disabled until the f2fs compression
# code is backported; enabling an undefined symbol here is a no-op.
# CONFIG_F2FS_FS_COMPRESSION is intentionally not set.
