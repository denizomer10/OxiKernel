# OxiKernel configuration - SAF AOSP / Android 16 GSI purity
#
# Removes Samsung Knox / TrustZone (TEE) / OneUI remnants so the kernel is a
# pure AOSP-targeted build for the official Android 16 (API 36) GSI.
#
# What "Knox" actually is in this tree (research finding):
#   TIMA / DEFEX / RKP / Rapport / Kinibi / UDR are NOT present in this AOSP
#   kernel at all. The only Knox-related layer is the TrustZone TEE access
#   channel (TZDEV / Teegris) plus Samsung Trusted UI. Those are removed here.
#
# PRESERVED (these carry the "SEC_" prefix but are Exynos HARDWARE drivers,
# not OneUI/Knox -- removing them breaks the phone):
#   SEC_NFC, SEC_SIPC_MODEM_IF, SEC_MODEM_SS310AP, SEC_SND_SYNCHRONIZED_IPC,
#   SEC_VIB (vibration motor), SEC_GPIO, SEC_PARAM, SEC_REBOOT, SEC_EXT,
#   SEC_MISC, SEC_DEBUG* (crash dump).
#
# FBE / inline crypto (FS_ENCRYPTION, BLK_INLINE_ENCRYPTION, FMP) is
# independent of TZDEV and is kept -- Android 16 file-based encryption needs it.

# ===========================================================================
# A. Samsung TrustZone / TEE (Knox access channel)  -- REMOVED
# ===========================================================================

# TZDEV = Samsung Teegris (TEEGRIS v2) TrustZone driver. This is the kernel
# side of the Knox / Secure Folder / DRM / keystore trustzone channel. The
# fingerprint driver has an exynos_smc() fallback when TZDEV is absent
# (verified in drivers/fingerprint/et7xx-spi.c), so nothing hard-depends on it.
# CONFIG_TZDEV is not set
# CONFIG_TZDEV_SK_PFNS_64BIT is not set
# CONFIG_TZDEV_USE_ARM_CALLING_CONVENTION is not set
# CONFIG_TZDEV_CMA is not set
# CONFIG_TZDEV_SK_MULTICORE is not set
# CONFIG_TZDEV_PAGE_MIGRATION is not set
# CONFIG_TZDEV_HOTPLUG is not set
# CONFIG_TZDEV_BOOST is not set
# CONFIG_TZDEV_DEPLOY_TZAR is not set
# CONFIG_TZDEV_KTHREADS_SMPBOOT is not set
# CONFIG_TZDEV_KTHREADS_NOTIFIER is not set
# CONFIG_TZDEV_DEBUG is not set
# CONFIG_TEEGRIS_VERSION is not set

# Samsung Trusted UI (runs inside the TEE, needs TZDEV's TEE client API).
# CONFIG_SAMSUNG_TUI is not set

# TZDEV helper: ION fd -> physical address converter for trustzone buffers.
# CONFIG_ION_FD2PHYS is not set

# Generic TEE framework / OP-TEE: not used on Exynos 9610 Teegris, keep off.
# CONFIG_TEE is not set
# CONFIG_OPTEE is not set

# ===========================================================================
# B. OneUI / Samsung telemetry & diagnostics  -- REMOVED
#
# Pure AOSP has no Samsung analytics. These add per-event bookkeeping and
# userspace-facing Samsung-only interfaces that a GSI never uses.
# ===========================================================================

# Samsung STI (System Test Infra) + ABC (Always-on Behavior Check) analytics.
# CONFIG_SEC_STI is not set
# CONFIG_SEC_ABC is not set
# CONFIG_SEC_ABC_HUB is not set

# Samsung TN NAD diagnostics (+ second NAD / balancer).
# CONFIG_SEC_NAD is not set
# CONFIG_SEC_SUPPORT_SECOND_NAD is not set
# CONFIG_SEC_NAD_BALANCER is not set

# Samsung power-management big-data collection.
# CONFIG_SEC_PM_BIGDATA is not set

# Samsung key event notifier (OneUI key handling).
# CONFIG_SEC_KEY_NOTIFIER is not set

# Samsung product-ship mode flag (OneUI build flavour).
# CONFIG_SAMSUNG_PRODUCT_SHIP is not set

# Samsung LMKD kill-history recorder (debug telemetry).
# CONFIG_SAMSUNG_LMKD_DEBUG is not set

# Samsung frozen-process thaw hook. AOSP uses the standard cgroup freezer.
# CONFIG_SAMSUNG_FREECESS is not set

# ===========================================================================
# C. Android 16 (API 36) GSI modernization / hardening
#
# Complements oxikernel_gsi-16.config with the remaining interfaces the
# official A16 GSI (gsi_arm64) probes for. All are standard AOSP kernel
# interfaces -- no Samsung specifics.
# ===========================================================================

# binderfs: modern Android mounts /dev/binderfs and creates binder devices
# dynamically. The legacy char devices remain for compatibility.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# sync_file / SW_SYNC: SurfaceFlinger and HWC use explicit fences. sw_sync is
# the userspace-visible timeline used by the graphics stack's test/dump paths.
CONFIG_SYNC_FILE=y
CONFIG_SW_SYNC=y

# DMA-BUF heap plumbing (4.14 uses ION; keep the shared-buffer core consistent).
CONFIG_DMA_SHARED_BUFFER=y

# Incremental FS: used by the GSI for streaming app installs (already in
# gsi-16, restated so the AOSP-pure profile is self-documenting).
CONFIG_INCREMENTAL_FS=y

# userfaultfd + seccomp: probed by ART / zygote on A13+ (already in gsi-16).
CONFIG_USERFAULTFD=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Namespaces for app sandboxing / microdroid (already in gsi-16).
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y